{
  "poll_interval_seconds": 25,
  "request_jitter_ms": 800,
  "llm_timeout_seconds": 240,
  "seed_on_first_run": true,
  "db_path": "hhmon.db",
  "log_path": "hhmon.log",

  "llm": {
    "provider": "openrouter",
    "model": "deepseek/deepseek-chat-v3-0324:free",
    "api_key": "env:OPENROUTER_API_KEY",
    "temperature": 0.6,
    "max_tokens": 1200
  },

  "llm_chain": [
    { "provider": "openrouter", "model": "deepseek/deepseek-chat-v3-0324:free", "api_key": "env:OPENROUTER_API_KEY" },
    { "provider": "groq", "model": "llama-3.3-70b-versatile", "api_key": "env:GROQ_API_KEY" },
    { "provider": "gemini", "model": "gemini-2.0-flash", "api_key": "env:GEMINI_API_KEY" },
    { "provider": "cerebras", "model": "llama3.1-8b", "api_key": "env:CEREBRAS_API_KEY" },
    { "provider": "mistral", "model": "open-mistral-7b", "api_key": "env:MISTRAL_API_KEY" },
    { "provider": "nvidia", "model": "meta/llama-3.3-70b-instruct", "api_key": "env:NVIDIA_API_KEY" },
    { "provider": "yandex", "model": "gpt://FOLDER_ID/yandexgpt-lite", "api_key": "env:YANDEX_API_KEY" },
    { "provider": "gigachat", "model": "GigaChat", "api_key": "env:GIGACHAT_AUTH_KEY" }
  ],

  "apply": {
    "enabled": false,
    "dry_run": true,
    "max_per_day": 20,
    "min_delay_seconds": 30,
    "session_path": "session.json",
    "resume_title_contains": "backend",
    "questions_via_llm": true,
    "skip_with_questions": false
  },

  "searches": [
    {
      "name": "PHP backend",
      "query": "php разработчик",
      "areas": [1],
      "search_period_days": 1,
      "exclude_keywords": ["1С", "QA", "тестировщик", "стажёр", "стажер", "продаж", "менеджер"],
      "profile_paths": ["profile.md", "profiles/php.md"]
    },
    {
      "name": "PHP Symfony/Laravel",
      "query": "symfony laravel",
      "areas": [1],
      "search_period_days": 1,
      "exclude_keywords": ["1С", "QA", "тестировщик", "стажёр", "стажер", "продаж", "менеджер"],
      "profile_paths": ["profile.md", "profiles/php.md"]
    },
    {
      "name": "Go backend",
      "query": "golang",
      "areas": [1],
      "search_period_days": 1,
      "exclude_keywords": ["1С", "QA", "тестировщик", "стажёр", "стажер", "продаж", "менеджер"],
      "profile_paths": ["profile.md", "profiles/go.md"]
    },
    {
      "name": "Backend / highload",
      "query": "backend разработчик",
      "areas": [1],
      "search_period_days": 1,
      "exclude_keywords": ["1С", "QA", "тестировщик", "стажёр", "стажер", "продаж", "менеджер"],
      "profile_paths": ["profile.md", "profiles/highload.md"]
    },
    {
      "name": "JavaScript / Node.js",
      "query": "node.js разработчик",
      "areas": [1],
      "search_period_days": 1,
      "exclude_keywords": ["1С", "QA", "тестировщик", "стажёр", "стажер", "продаж", "менеджер"],
      "profile_paths": ["profile.md", "profiles/js.md"]
    },
    {
      "name": "Blockchain / Crypto",
      "query": "blockchain",
      "areas": [1],
      "search_period_days": 1,
      "exclude_keywords": ["1С", "QA", "тестировщик", "стажёр", "стажер", "продаж", "менеджер"],
      "profile_paths": ["profile.md", "profiles/blockchain.md"]
    },
    {
      "name": "Data Science",
      "query": "data science",
      "areas": [1],
      "search_period_days": 1,
      "exclude_keywords": ["1С", "QA", "тестировщик", "стажёр", "стажер", "продаж", "менеджер"],
      "profile_paths": ["profile.md", "profiles/data.md"]
    },
    {
      "name": "Аналитик данных",
      "query": "аналитик данных",
      "areas": [1],
      "search_period_days": 1,
      "exclude_keywords": ["1С", "QA", "тестировщик", "стажёр", "стажер", "продаж", "менеджер"],
      "profile_paths": ["profile.md", "profiles/data.md"]
    },
    {
      "name": "ML-инженер",
      "query": "machine learning",
      "areas": [1],
      "search_period_days": 1,
      "exclude_keywords": ["1С", "QA", "тестировщик", "стажёр", "стажер", "продаж", "менеджер"],
      "profile_paths": ["profile.md", "profiles/ml.md"]
    },
    {
      "name": "Embedded",
      "query": "embedded разработчик",
      "areas": [1],
      "search_period_days": 1,
      "exclude_keywords": ["1С", "QA", "тестировщик", "стажёр", "стажер", "продаж", "менеджер"],
      "profile_paths": ["profile.md", "profiles/embedded.md"]
    }
  ]
}
